<launch>
    <arg name="use_sim_time" default="false"/>

    <arg name="launch_robot_core" default="true"/>
    <arg name="launch_description" default="true"/>
    <arg name="robot_urdf_path" default="$(find-pkg-share puzzlebot_real_robot)/urdf/puzzlebot_jetson_lidar_real.urdf"/>
    <arg name="launch_micro_ros" default="false"/>
    <arg name="micro_ros_transport" default="serial"/>
    <arg name="micro_ros_device" default="/dev/ttyACM0"/>
    <arg name="micro_ros_baud" default="115200"/>

    <arg name="launch_lidar" default="true"/>
    <arg name="launch_rplidar" default="true"/>
    <arg name="launch_servo_scan" default="false"/>
    <arg name="lidar_channel_type" default="serial"/>
    <arg name="lidar_serial_port" default="/dev/ttyUSB0"/>
    <arg name="lidar_serial_baudrate" default="115200"/>
    <arg name="lidar_frame_id" default="laser_frame"/>
    <arg name="lidar_topic" default="/scan"/>
    <arg name="lidar_inverted" default="false"/>
    <arg name="lidar_angle_compensate" default="true"/>
    <arg name="lidar_scan_mode" default="Standard"/>
    <arg name="laser_distance_topic" default="/LaserDistance"/>
    <arg name="servo_angle_topic" default="/ServoAngle"/>
    <arg name="servo_message_type" default="float32"/>
    <arg name="servo_angle_units" default="degrees"/>
    <arg name="servo_center_angle" default="90.0"/>
    <arg name="servo_angle_sign" default="1.0"/>
    <arg name="laser_distance_scale" default="1.0"/>
    <arg name="laser_range_min" default="0.03"/>
    <arg name="laser_range_max" default="4.0"/>
    <arg name="laser_angle_min" default="-1.57079632679"/>
    <arg name="laser_angle_max" default="1.57079632679"/>
    <arg name="laser_angle_increment" default="0.01745329252"/>

    <arg name="launch_localization" default="true"/>
    <arg name="launch_joint_states" default="true"/>
    <arg name="left_encoder_topic" default="/VelocityEncL"/>
    <arg name="right_encoder_topic" default="/VelocityEncR"/>
    <arg name="encoder_message_type" default="auto"/>
    <arg name="encoder_units" default="rad_per_sec"/>
    <arg name="encoder_timeout" default="0.5"/>
    <arg name="ticks_per_revolution" default="20.0"/>
    <arg name="wheel_radius" default="0.05"/>
    <arg name="wheel_separation" default="0.19"/>
    <arg name="odom_frame_id" default="odom"/>
    <arg name="base_frame_id" default="base_footprint"/>

    <arg name="map_path" default="$(find-pkg-share puzzlebot_real_robot)/maps/map_maze_real.yaml"/>
    <arg name="nav2_params_file" default="$(find-pkg-share puzzlebot_real_robot)/config/nav2_params_real.yaml"/>
    <arg name="nav2_rviz_config_path" default="$(find-pkg-share puzzlebot_real_robot)/rviz/nav2_real.rviz"/>
    <arg name="launch_rviz" default="true"/>
    <arg name="autostart" default="true"/>

    <include file="$(find-pkg-share puzzlebot_real_robot)/launch/real_robot_core.launch.xml"
             if="$(var launch_robot_core)">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="launch_description" value="$(var launch_description)"/>
        <arg name="robot_urdf_path" value="$(var robot_urdf_path)"/>
        <arg name="launch_micro_ros" value="$(var launch_micro_ros)"/>
        <arg name="micro_ros_transport" value="$(var micro_ros_transport)"/>
        <arg name="micro_ros_device" value="$(var micro_ros_device)"/>
        <arg name="micro_ros_baud" value="$(var micro_ros_baud)"/>
        <arg name="launch_lidar" value="$(var launch_lidar)"/>
        <arg name="launch_rplidar" value="$(var launch_rplidar)"/>
        <arg name="launch_servo_scan" value="$(var launch_servo_scan)"/>
        <arg name="lidar_channel_type" value="$(var lidar_channel_type)"/>
        <arg name="lidar_serial_port" value="$(var lidar_serial_port)"/>
        <arg name="lidar_serial_baudrate" value="$(var lidar_serial_baudrate)"/>
        <arg name="lidar_frame_id" value="$(var lidar_frame_id)"/>
        <arg name="lidar_topic" value="$(var lidar_topic)"/>
        <arg name="lidar_inverted" value="$(var lidar_inverted)"/>
        <arg name="lidar_angle_compensate" value="$(var lidar_angle_compensate)"/>
        <arg name="lidar_scan_mode" value="$(var lidar_scan_mode)"/>
        <arg name="laser_distance_topic" value="$(var laser_distance_topic)"/>
        <arg name="servo_angle_topic" value="$(var servo_angle_topic)"/>
        <arg name="servo_message_type" value="$(var servo_message_type)"/>
        <arg name="servo_angle_units" value="$(var servo_angle_units)"/>
        <arg name="servo_center_angle" value="$(var servo_center_angle)"/>
        <arg name="servo_angle_sign" value="$(var servo_angle_sign)"/>
        <arg name="laser_distance_scale" value="$(var laser_distance_scale)"/>
        <arg name="laser_range_min" value="$(var laser_range_min)"/>
        <arg name="laser_range_max" value="$(var laser_range_max)"/>
        <arg name="laser_angle_min" value="$(var laser_angle_min)"/>
        <arg name="laser_angle_max" value="$(var laser_angle_max)"/>
        <arg name="laser_angle_increment" value="$(var laser_angle_increment)"/>
        <arg name="launch_localization" value="$(var launch_localization)"/>
        <arg name="launch_joint_states" value="$(var launch_joint_states)"/>
        <arg name="left_encoder_topic" value="$(var left_encoder_topic)"/>
        <arg name="right_encoder_topic" value="$(var right_encoder_topic)"/>
        <arg name="encoder_message_type" value="$(var encoder_message_type)"/>
        <arg name="encoder_units" value="$(var encoder_units)"/>
        <arg name="encoder_timeout" value="$(var encoder_timeout)"/>
        <arg name="ticks_per_revolution" value="$(var ticks_per_revolution)"/>
        <arg name="wheel_radius" value="$(var wheel_radius)"/>
        <arg name="wheel_separation" value="$(var wheel_separation)"/>
        <arg name="odom_frame_id" value="$(var odom_frame_id)"/>
        <arg name="base_frame_id" value="$(var base_frame_id)"/>
    </include>

    <include file="$(find-pkg-share puzzlebot_real_robot)/launch/nav2_real_core.launch.xml">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="map_path" value="$(var map_path)"/>
        <arg name="nav2_params_file" value="$(var nav2_params_file)"/>
        <arg name="nav2_rviz_config_path" value="$(var nav2_rviz_config_path)"/>
        <arg name="launch_rviz" value="$(var launch_rviz)"/>
        <arg name="autostart" value="$(var autostart)"/>
    </include>
</launch>
